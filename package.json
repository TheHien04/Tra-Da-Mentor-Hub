{
  "name": "tra-da-mentor",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "node backend/server.js",
    "dev:server": "nodemon backend/server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "seed": "node backend/scripts/seed.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:unit:ci": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
    "test:frontend": "vitest run",
    "test:frontend:ci": "vitest run --coverage",
    "quality": "node scripts/quality-gate.mjs",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:crossbrowser": "playwright test e2e/cross-browser.spec.ts --project=firefox --project=webkit",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "test:load": "node scripts/performance-smoke.mjs",
    "test:ops": "node scripts/operational-smoke.mjs",
    "test:security-smoke": "node scripts/security-smoke.mjs",
    "merge:locales": "node scripts/merge-locales.mjs",
    "check:locales": "node scripts/check-locale-parity.mjs",
    "check:traceability": "node scripts/check-traceability.mjs",
    "generate:api": "openapi-typescript docs/openapi.json -o src/types/openapi.ts",
    "check:openapi": "node scripts/check-openapi.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "start": "NODE_ENV=production node backend/server.js",
    "start:prod": "npm run build && npm run start",
    "verify:env": "node scripts/verify-production-env.mjs",
    "setup:deploy": "node scripts/setup-production.mjs",
    "deploy:prep": "node scripts/deploy-prep.mjs",
    "check:secrets": "node scripts/check-secrets-not-tracked.mjs",
    "audit:ci": "npm audit --omit=dev --audit-level=moderate",
    "create:admin": "node scripts/create-admin.mjs",
    "backup:db": "bash scripts/backup-mongodb.sh",
    "restore:db": "bash scripts/restore-mongodb.sh",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "dependencies": {
    "@sentry/node": "^10.53.1",
    "@sentry/react": "^10.53.1",
    "@stripe/stripe-js": "^8.7.0",
    "@tanstack/react-query": "^5.100.10",
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "googleapis": "^171.4.0",
    "helmet": "^8.1.0",
    "i18next": "^25.8.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.16.0",
    "mongoose": "^8.24.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.5.4",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-modal": "^3.16.3",
    "react-router-dom": "^7.6.0",
    "react-toastify": "^11.0.5",
    "react-tooltip": "^5.28.1",
    "recharts": "^2.15.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stripe": "^20.3.1",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/react-modal": "^3.16.3",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^9.1.2",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "openapi-typescript": "^7.13.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "^5.0.5"
  }
}
